<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	
	
	<bean name="emp1" class="learning.spring.model.Employee">
	
		<property name="id" value="202" />
		<property name="name" value="Vikas" />
		<property name="gender" value="Male" />
		
	</bean>
	
	
	<bean name="emp2" class="learning.spring.model.Employee">
	
		<constructor-arg name="id" value="123" />
		<constructor-arg name="name" value="Amit" />
		<constructor-arg name="gender" value="Male" />	
	
	</bean>
		
</beans>