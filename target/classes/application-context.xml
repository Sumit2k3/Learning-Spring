<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean name="add1" class="learning.spring.model.Address">
	
		<property name="city" value="Noida" />
		<property name="state" value="UP" />	
	
	</bean>
	
	
	<bean name="emp1" class="learning.spring.model.Employee" init-method="xmlIntiMethod" destroy-method="xmlDestroyMethod">
	
		<property name="id" value="202" />
		<property name="name" value="Vikas" />
		<property name="gender" value="Male" />
		<property name="address" ref="add1" />
		
	</bean>
		
</beans>